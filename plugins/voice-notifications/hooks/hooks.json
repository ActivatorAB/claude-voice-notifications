{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" done", "async": true, "timeout": 30 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" error", "async": true, "timeout": 30 } ] }
    ],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" permission", "async": true, "timeout": 30 } ] },
      { "matcher": "elicitation_dialog", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" input", "async": true, "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" input", "async": true, "timeout": 30 } ] },
      { "matcher": "ExitPlanMode", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" permission", "async": true, "timeout": 30 } ] }
    ]
  }
}
